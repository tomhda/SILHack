{
  "manifest_version": 3,
  "name": "SILHack-dev",
  "version": "0.2.2",
  "description": "Change Enter key behavior and add quick formatting helpers for chat input fields.",
  "permissions": ["storage"],
  "options_page": "options/options.html",
  "action": {
    "default_title": "SILHack-dev settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["js/settings.js", "js/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": ["js/settings.js", "js/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chatwork.com/*",
        "https://chatwork.com/*"
      ],
      "js": ["js/settings.js", "js/chatwork_tags.js"],
      "run_at": "document_idle"
    }
  ]
}
